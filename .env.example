# ==============================================
# GYAAN E-COMMERCE ENVIRONMENT CONFIGURATION
# ==============================================

# Server Configuration
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/gyaan
# For MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/gyaan?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=gyaan_jwt_super_secret_key_change_in_production_2026_xyz
JWT_EXPIRE=7d

# Razorpay Payment Gateway (Test Mode)
# Obtain test credentials from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere

# Default Admin Seed Credentials
ADMIN_NAME=Gyaan Admin
ADMIN_EMAIL=admin@gyaan.com
ADMIN_PASSWORD=Admin@Gyaan2026

# Storage / Cloudinary (Optional future CDN integration)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
